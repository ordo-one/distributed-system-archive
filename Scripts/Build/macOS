#!/bin/bash

set -euo pipefail
set -x

xcodegen generate

LIBRARY_NAME=DistributedABI
SCHEME_NAME=internal-distributed-system
OUTPUT_NAME=${LIBRARY_NAME}-macOS.xcframework

rm -rf archives

for platform in 'macOS' 'iOS' 'iOS Simulator'; do
    xcodebuild archive \
        -scheme ${LIBRARY_NAME}_${platform%% *} \
        -destination "generic/platform=${platform}" \
        -archivePath "archives/${platform// /_}.xcarchive"
done

rm -rf "${OUTPUT_NAME}"

xcodebuild -create-xcframework \
    -archive archives/macOS.xcarchive -framework ${LIBRARY_NAME}.framework \
    -archive archives/iOS.xcarchive -framework ${LIBRARY_NAME}.framework \
    -archive archives/iOS_Simulator.xcarchive -framework ${LIBRARY_NAME}.framework \
    -output "${OUTPUT_NAME}"

zip --symlinks -r "${OUTPUT_NAME}.zip" "${OUTPUT_NAME}"
