#!/bin/bash

set -euo pipefail
set -x

xcodegen generate

MODULE_NAME=OrdoDistributedABI
OUTPUT_NAME=${MODULE_NAME}-macOS.xcframework

rm -rf archives

for platform in 'macOS' 'iOS' 'iOS Simulator'; do
    xcodebuild archive \
        -scheme ${MODULE_NAME}_${platform%% *} \
        -destination "generic/platform=${platform}" \
        -archivePath "archives/${platform// /_}.xcarchive"
done

rm -rf "${OUTPUT_NAME}"

xcodebuild -create-xcframework \
    -archive archives/macOS.xcarchive -framework ${MODULE_NAME}.framework \
    -archive archives/iOS.xcarchive -framework ${MODULE_NAME}.framework \
    -archive archives/iOS_Simulator.xcarchive -framework ${MODULE_NAME}.framework \
    -output "${OUTPUT_NAME}"

zip --symlinks -r "${OUTPUT_NAME}.zip" "${OUTPUT_NAME}"
